{
  "permissions": {
    "allow": [
      "PowerShell(npx tsc --noEmit 2>&1 | Out-String -Width 500)",
      "PowerShell(npx tsc --noEmit; Write-Output \"EXITCODE:$LASTEXITCODE\")",
      "PowerShell(npx tsc --noEmit -p tsconfig.app.json 2>&1 | Out-String -Width 500; Write-Output \"EXIT:$LASTEXITCODE\")",
      "PowerShell(Remove-Item *)",
      "PowerShell(npx tsc --noEmit -p tsconfig.node.json 2>&1 | Out-String -Width 500; Write-Output \"EXIT:$LASTEXITCODE\")",
      "PowerShell(npm install *)",
      "PowerShell(Test-Path \"node_modules\\\\@supabase\\\\supabase-js\"; npx tsc --noEmit -p tsconfig.app.json 2>&1 | Out-String -Width 500; Write-Output \"EXIT:$LASTEXITCODE\")",
      "PowerShell(npm audit *)",
      "PowerShell(npx tsc -b --noEmit 2>&1 | Out-String -Width 500; Write-Output \"EXIT:$LASTEXITCODE\")"
    ]
  }
}
